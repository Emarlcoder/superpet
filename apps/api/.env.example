PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# pnpm db:local creates a private local .env automatically when none exists.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:55432/superpet
# Direct connection for migrations when DATABASE_URL uses a remote pooler.
# DATABASE_URL_UNPOOLED=
# Keep automated integration tests on a separate LOCAL database connection.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:55432/superpet
APP_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
OPERATION_EPOCH=REPLACE_WITH_A_RANDOM_UUID
MEDIA_DIR=../../.local/media
# Production only; configure before deployment, never commit real values.
# RESEND_API_KEY=
# MAIL_FROM=SuperPet <acceso@example.com>
# R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_BUCKET=
